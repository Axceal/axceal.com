# Database — Neon Postgres (pooled URL)
DATABASE_URL=

# Redis — Upstash REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NextAuth v5 — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email — Resend (required from Phase 3)
RESEND_API_KEY=
EMAIL_FROM=

# Razorpay — test keys in dev, live keys in production (required from Phase 7)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Node runtime
NODE_ENV=development
