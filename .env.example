# Database — Neon Postgres (pooled URL)
DATABASE_URL=

# Redis — Upstash REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NextAuth v5 — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Email — Resend (required from Phase 3)
RESEND_API_KEY=
EMAIL_FROM=

# Razorpay — test keys in dev, live keys in production (required from Phase 7)
# KEY_ID + KEY_SECRET: required for /api/payments/initiate + /api/payments/verify.
# WEBHOOK_SECRET: required only for /api/payments/webhook. Generated by Razorpay
# dashboard when the webhook endpoint is registered. Leave unset in dev until
# ngrok + dashboard webhook is configured — the route 500s in the meantime.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Twilio Verify — required for phone OTP verification
# ACCOUNT_SID + AUTH_TOKEN: from console.twilio.com → Account Info
# VERIFY_SERVICE_SID: console.twilio.com → Verify → Services → create a service → copy SID
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Node runtime
NODE_ENV=development

# Sales mode — controls waitlist gating vs live checkout.
#   waitlist  (default) — checkout blocked, CTA opens waitlist popup
#   live                — production post-launch, normal purchase flow
#   dev-live            — dev-only override behaving like `live`. Rejected when NODE_ENV=production.
NEXT_PUBLIC_SALES_MODE=waitlist
